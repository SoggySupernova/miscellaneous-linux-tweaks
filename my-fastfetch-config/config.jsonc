{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    {
    "type": "colors",
    "symbol": "circle",
    "paddingLeft": 2,
      "block": {
        "range": [0, 7]
      }
    },
    {
    "type": "colors",
    "symbol": "circle",
    "paddingLeft": 2,
      "block": {
        "range": [8, 15]
      }
    }

  ]
}
